# Copy this file to .env on the GPU host; never commit .env.
# DNS: A record for this domain must point to the GPU server's public IPv4 address.
NBX_GPU_DOMAIN=gpu.your-domain.example
# Set a long randomly generated key, e.g. openssl rand -hex 32
ACESTEP_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
